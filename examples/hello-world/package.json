{
  "name": "cr-26-example-app",
  "version": "0.1.0",
  "description": "cr-26 example app",
  "type": "module",
  "scripts": {
    "dev": "parcel --no-cache ./index.html",
    "ts:check": "tsc --noEmit",
    "ts:clean": "rm -rf ./dist ./.parcel-cache",
    "ts:build": "yarn ts:clean && tsc --noEmit && cross-env NODE_ENV=production parcel build ./index.html --public-url ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts'"
  },
  "author": "Rob Crawford",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robCrawford/cr-26.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@parcel/transformer-typescript-tsc": "^2.13.3",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/ui": "^4.1.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^29.1.1",
    "parcel": "^2.13.3",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
